<odoo>
    <record id="action_invoice_product_report_wizard" model="ir.actions.act_window">
        <field name="name">Invoice Product Report</field>
        <field name="res_model">invoice.product.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_invoice_product_report_wizard_form" model="ir.ui.view">
        <field name="name">invoice.product.report.wizard.form</field>
        <field name="model">invoice.product.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Product Report">
                <sheet>
                    <group>
                        <group name="date_range_group">
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group name="customer_group">
                            <field name="customer_ids" widget="many2many_tags" />
                            <field name="company_ids" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                    string="View"
                    name="action_export_html"
                    type="object"
                    class="btn-primary"
                    default_focus="1"
                /> or
                    <button
                    string="Export PDF"
                    name="action_export_pdf"
                    type="object"
                    class="btn-secondary"
                /> or
                    <button
                    string="Export Excel"
                    name="action_export_excel"
                    type="object"
                    class="btn-secondary"
                /> or
                    <button
                    string="Cancel"
                    class="btn-secondary"
                    special="cancel"
                    data-hotkey="z"
                />
                </footer>
            </form>
        </field>
    </record>
</odoo>
