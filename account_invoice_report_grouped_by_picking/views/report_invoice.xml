<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="lines_grouped" t-value="o.lines_grouped_by_picking()" />
            <t
                t-set="has_pickings"
                t-value="bool(list(filter(lambda line_group: line_group['picking'], lines_grouped)))"
            />
        </xpath>
        <xpath
            expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines_to_report']"
            position="before"
        >
            <t t-set="subtotal" t-value="0.0" />
            <t t-set="last_picking" t-value="None" />
        </xpath>
        <xpath
            expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines_to_report']"
            position="attributes"
        >
            <attribute name="t-foreach">lines_grouped</attribute>
            <attribute name="t-as">lines_group</attribute>
        </xpath>
        <xpath expr="//t[@t-set='is_note']" position="before">
            <t t-set="l" t-value="lines_group['line']" />
            <t t-set="line" t-value="lines_group['line']" />
            <t t-set="picking" t-value="lines_group['picking']" />
            <t
                t-set="next_picking"
                t-value="lines_grouped[lines_group_index + 1]['picking'] if lines_group_index &lt; len(lines_grouped) - 1 else False"
            />
            <t
                t-if="o.journal_id.show_group_by_picking_report and has_pickings and picking != last_picking"
            >
                <t t-set="last_picking" t-value="picking" />
                <tr t-if="picking">
                    <td colspan="10">
                        <strong>
                            <span>Order:</span>
                            <span t-field="picking.sale_id.name" />
                            <t t-if="picking.sale_id.client_order_ref">
                                <span t-translation="off"> (</span>
                                <span t-field="picking.sale_id.client_order_ref" />
                                <span t-translation="off">)</span>
                            </t>
                            <span>Picking:</span>
                            <span
                                t-field="picking.date_done"
                                t-options="{'widget': 'date'}"
                            />
                            <span t-field="picking.name" />
                        </strong>
                    </td>
                </tr>
                <tr t-else="">
                    <td colspan="10">
                        <strong>
                            <span>Without reference</span>
                        </strong>
                    </td>
                </tr>
            </t>
        </xpath>
        <xpath
            expr="//td[@name='td_quantity']/span[@t-field='line.quantity']"
            position="attributes"
        >
            <attribute name="t-out">lines_group['quantity']</attribute>
            <attribute name="t-field" />
            <attribute
                name="t-options"
            >{'widget': 'float', 'decimal_precision': 'Product Unit'}</attribute>
        </xpath>
        <xpath
            expr="//td[@name='td_subtotal']/span[@t-field='line.price_subtotal']"
            position="before"
        >
            <t
                t-set="line_amount"
                t-value="l.price_total if o.document_tax_mode == 'tax_included' else l.price_subtotal"
            />
            <t t-if="not hide_prices and lines_group['quantity'] != l.quantity">
                <t
                    t-set="line_picking_subtotal"
                    t-value="l.quantity and lines_group['quantity'] * (line_amount / l.quantity) or 0.0"
                />
                <t
                    t-set="subtotal"
                    t-value="(subtotal or 0.0) + line_picking_subtotal"
                />
                <span
                    t-out="line_picking_subtotal"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
            </t>
            <t t-elif="not hide_prices">
                <t t-set="subtotal" t-value="(subtotal or 0.0) + line_amount" />
            </t>
        </xpath>
        <xpath
            expr="//td[@name='td_subtotal']/span[@t-field='line.price_subtotal']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not hide_prices and o.document_tax_mode == 'tax_excluded' and lines_group['quantity'] == l.quantity</attribute>
        </xpath>
        <xpath
            expr="//td[@name='td_subtotal']/span[@t-field='line.price_total']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not hide_prices and o.document_tax_mode == 'tax_included' and lines_group['quantity'] == l.quantity</attribute>
        </xpath>
        <xpath
            expr="//t[@t-if='not hide_details and not hide_prices']/tr"
            position="after"
        >
            <tr
                t-if="o.journal_id.show_group_by_picking_report and has_pickings and line.display_type == 'product' and not hide_prices and picking != next_picking"
            >
                <td colspan="10" class="text-end">
                    <strong>Subtotal: </strong>
                    <strong
                        t-out="subtotal"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                    />
                </td>
                <t t-set="subtotal" t-value="0.0" />
            </tr>
        </xpath>
    </template>
</odoo>
