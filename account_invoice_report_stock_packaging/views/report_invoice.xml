<data>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath
            expr="//table[@name='invoice_line_table']//td[@name='td_quantity']"
            position="inside"
        >
            <t t-set="packaging_info" t-value="line._get_packaging_info()" />
            <span t-if="packaging_info" class="ms-1">(<t
                t-out="packaging_info"
            />)</span>
        </xpath>
    </template>
</data>
