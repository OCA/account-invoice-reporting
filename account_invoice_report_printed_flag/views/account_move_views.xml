<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- TREE: general journal entries -->
    <record id="view_move_tree_printed" model="ir.ui.view">
        <field name="name">account.move.tree.printed</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="printed" optional="show" />
                <field name="printed_report_names" optional="hide" />
                <button
                    name="action_view_printed_logs"
                    type="object"
                    string="Logs"
                    invisible="not printed_report_names"
                    icon="fa-print"
                    groups="account.group_account_manager"
                />
            </field>
        </field>
    </record>

    <!-- TREE: customer invoices -->
    <record id="view_out_invoice_tree_printed" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.printed</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="printed" optional="show" />
                <field name="printed_report_names" optional="hide" />
                <button
                    name="action_view_printed_logs"
                    type="object"
                    string="Logs"
                    invisible="not printed_report_names"
                    icon="fa-print"
                    groups="account.group_account_manager"
                />
            </xpath>
        </field>
    </record>

    <!-- TREE: vendor bills -->
    <record id="view_in_invoice_tree_printed" model="ir.ui.view">
        <field name="name">account.move.in.invoice.tree.printed</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="printed" optional="show" />
                <field name="printed_report_names" optional="hide" />
                <button
                    name="action_view_printed_logs"
                    type="object"
                    string="Logs"
                    invisible="not printed_report_names"
                    icon="fa-print"
                    groups="account.group_account_manager"
                />
            </xpath>
        </field>
    </record>

    <!-- SEARCH: invoices (shared view for all invoice types) -->
    <record id="view_account_invoice_search_printed" model="ir.ui.view">
        <field name="name">account.move.invoice.search.printed</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <separator />
                <filter
                    name="printed_true"
                    string="Printed"
                    domain="[('printed', '=', True)]"
                />
                <filter
                    name="printed_false"
                    string="Not Printed"
                    domain="[('printed', '=', False)]"
                />
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter
                    name="group_by_printed"
                    string="Printed"
                    context="{'group_by': 'printed'}"
                />
                <filter
                    name="group_by_printed_report_names"
                    string="Printed Report Names"
                    context="{'group_by': 'printed_report_names'}"
                />
            </xpath>
        </field>
    </record>

    <!-- SEARCH: journal entries -->
    <record id="view_move_search_printed" model="ir.ui.view">
        <field name="name">account.move.search.printed</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <separator />
                <filter
                    name="printed_true"
                    string="Printed"
                    domain="[('printed', '=', True)]"
                />
                <filter
                    name="printed_false"
                    string="Not Printed"
                    domain="[('printed', '=', False)]"
                />
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter
                    name="group_by_printed"
                    string="Printed"
                    context="{'group_by': 'printed'}"
                />
                <filter
                    name="group_by_printed_report_names"
                    string="Printed Report Names"
                    context="{'group_by': 'printed_report_names'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
